{
  "expo": {
    "name": "ScorpionTV",
    "slug": "ScorpionTV",
    "version": "4.7.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scorpiontv",
    "userInterfaceStyle": "automatic",


    "ios": {
      "icon": "./assets/expo.icon"
    },

    "android": {
      "package": "com.scorpionhigt.ScorpionTV",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },

      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "expo-router",
      "expo-notifications",
      "expo-video",
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "./plugins/withCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "inset-swipe"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "21ccaa35-1852-44c4-acac-1c228e4fac92"
      }
    },

    "updates": {
      "url": "https://u.expo.dev/21ccaa35-1852-44c4-acac-1c228e4fac92"
    },

    "runtimeVersion": {
      "policy": "appVersion"
    }


  }
}
