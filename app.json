{
  "expo": {
    "name": "ScorpionTV",
    "slug": "ScorpionTV",
    "version": "2.8.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scorpiontv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scorpionhigt.ScorpionTV"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light",
          "hidden": false,
          "position": "absolute"
        }
      ],
      "expo-video",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light",
        "hidden": false
      },
      "eas": {
        "projectId": "21ccaa35-1852-44c4-acac-1c228e4fac92"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21ccaa35-1852-44c4-acac-1c228e4fac92"
    }
  }
}
